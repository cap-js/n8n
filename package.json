{
  "name": "@cap-js/n8n",
  "version": "0.1.0",
  "description": "CAP Plugin to trigger n8n workflows from CAP applications via annotations and a programmatic service.",
  "main": "cds-plugin.js",
  "files": [
    "cds-plugin.js",
    "lib/",
    "srv/*.cds",
    "srv/*.js"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:live": "vitest run tests/integration/rest",
    "test:console": "vitest run tests/integration/console tests/unit",
    "test:hybrid": "cds bind --exec -- vitest run",
    "lint": "node -e \"console.log('no linter configured yet')\""
  },
  "keywords": [
    "cds",
    "cap",
    "n8n",
    "workflow",
    "automation",
    "sap"
  ],
  "author": "SAP SE (https://www.sap.com)",
  "license": "Apache-2.0",
  "type": "commonjs",
  "peerDependencies": {
    "@sap/cds": ">=9",
    "@sap-cloud-sdk/connectivity": "^4"
  },
  "peerDependenciesMeta": {
    "@sap-cloud-sdk/connectivity": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "tests/bookshop/"
  ],
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^3",
    "@sap-cloud-sdk/connectivity": "^4.5.1",
    "@sap/cds": "^10",
    "@sap/cds-dk": "^10",
    "vitest": "^4"
  },
  "cds": {
    "requires": {
      "N8nService": {
        "kind": "rest-n8n-service",
        "credentials": {
          "baseUrl": "env:N8N_BASE_URL",
          "apiKey": "env:N8N_API_KEY"
        },
        "[development]": {
          "credentials": {
            "baseUrl": "http://localhost:5678"
          }
        }
      },
      "kinds": {
        "rest-n8n-service": {
          "model": "@cap-js/n8n/srv/N8nService",
          "impl": "@cap-js/n8n/srv/restN8nService",
          "outboxed": {
            "kind": "persistent-queue"
          },
          "vcap": {
            "tag": "n8n"
          }
        },
        "console-n8n-service": {
          "model": "@cap-js/n8n/srv/consoleN8nService",
          "impl": "@cap-js/n8n/srv/consoleN8nService",
          "outboxed": {
            "kind": "in-memory-queue"
          }
        }
      }
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "fsevents@2.3.3": true,
    "esbuild@0.21.5": true
  }
}
