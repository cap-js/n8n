{
  "name": "@cap-js/n8n",
  "version": "0.1.0",
  "description": "CAP Plugin to trigger n8n workflows",
  "author": "SAP SE (https://www.sap.com)",
  "license": "Apache-2.0",
  "homepage": "https://cap.cloud.sap/",
  "repository": "cap-js/n8n",
  "main": "cds-plugin.js",
  "files": [
    "cds-plugin.js",
    "lib/",
    "srv/",
    "LICENSES"
  ],
  "scripts": {
    "test": "npx vitest run",
    "test:hybrid": "cds bind --exec -- npx vitest run",
    "lint": "npx eslint .",
    "prettier": "npx -y prettier@3 --write .",
    "prettier:check": "npx -y prettier@3 --check ."
  },
  "keywords": [
    "cds",
    "cap",
    "n8n",
    "workflow",
    "automation",
    "sap"
  ],
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4.5.1"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1"
  },
  "peerDependencies": {
    "@sap/cds": ">=9"
  },
  "cds": {
    "requires": {
      "N8nService": {
        "[development]": {
          "kind": "n8n-to-console"
        },
        "[hybrid]": {
          "kind": "n8n-to-rest",
          "credentials": {
            "url": "http://localhost:5678"
          }
        },
        "[production]": {
          "kind": "n8n-to-rest"
        }
      },
      "kinds": {
        "n8n-to-console": {
          "model": "@cap-js/n8n/srv/n8n-to-console",
          "impl": "@cap-js/n8n/srv/n8n-to-console",
          "outboxed": true
        },
        "n8n-to-rest": {
          "model": "@cap-js/n8n/srv/N8nService",
          "impl": "@cap-js/n8n/srv/n8n-to-rest",
          "outboxed": true,
          "vcap": {
            "tag": "n8n"
          }
        }
      }
    }
  },
  "workspaces": [
    "tests/bookshop/"
  ]
}
