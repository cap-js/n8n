{
  "name": "@cap-js/n8n",
  "version": "0.1.0",
  "description": "CAP Plugin to trigger n8n workflows from CAP applications via annotations and a programmatic service.",
  "main": "cds-plugin.js",
  "homepage": "https://cap.cloud.sap/",
  "repository": "cap-js/n8n",
  "bugs": {
    "url": "https://github.com/cap-js/n8n/issues"
  },
  "files": [
    "cds-plugin.js",
    "lib/",
    "srv/",
    "LICENSES"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:live": "vitest run tests/integration/rest",
    "test:console": "vitest run tests/integration/console tests/unit",
    "test:hybrid": "cds bind --exec -- vitest run",
    "lint": "npx eslint .",
    "prettier": "npx -y prettier@3 --write .",
    "prettier:check": "npx -y prettier@3 --check ."
  },
  "keywords": [
    "cds",
    "cap",
    "n8n",
    "workflow",
    "automation",
    "sap"
  ],
  "author": "SAP SE (https://www.sap.com)",
  "license": "Apache-2.0",
  "type": "commonjs",
  "peerDependencies": {
    "@sap/cds": ">=9",
    "@sap-cloud-sdk/connectivity": "^4"
  },
  "peerDependenciesMeta": {
    "@sap-cloud-sdk/connectivity": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "tests/bookshop/"
  ],
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^3",
    "@sap-cloud-sdk/connectivity": "^4.5.1",
    "@sap/cds": "^10",
    "@sap/cds-dk": "^10",
    "vitest": "^4"
  },
  "cds": {
    "requires": {
      "N8nService": {
        "kind": "rest-n8n-service",
        "[development]": {
          "kind": "console-n8n-service"
        }
      },
      "kinds": {
        "rest-n8n-service": {
          "model": "@cap-js/n8n/srv/N8nService",
          "impl": "@cap-js/n8n/srv/restN8nService",
          "outboxed": true,
          "vcap": {
            "tag": "n8n"
          }
        },
        "console-n8n-service": {
          "model": "@cap-js/n8n/srv/consoleN8nService",
          "impl": "@cap-js/n8n/srv/consoleN8nService",
          "outboxed": true
        }
      }
    }
  }
}
