{
  "name": "bookshop-n8n",
  "version": "1.0.0",
  "description": "Bookshop sample demonstrating @cap-js/n8n annotation-driven and programmatic workflow triggering.",
  "private": true,
  "dependencies": {
    "@cap-js/n8n": "file:../../.",
    "@cap-js/hana": ">=2"
  },
  "devDependencies": {
    "@cap-js/sqlite": ">=2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "import-workflows": "node scripts/import-workflows.js"
  },
  "sapux": [
    "app/admin-books",
    "app/browse"
  ],
  "cds": {
    "requires": {
      "n8n": {
        "[hybrid]": {
          "kind": "n8n-to-rest",
          "credentials": {
            "url": "http://localhost:5678",
            "useTestWebhook": false
          }
        },
        "[test]": {
          "outboxed": false
        }
      }
    }
  }
}
