# n8n base URL used by @cap-js/n8n. Development profile defaults to
# http://localhost:5678 when this variable is unset.
N8N_BASE_URL=http://localhost:5678

# Optional API key. n8n Cloud requires this; a fresh local docker instance
# does not until you enable auth in the UI.
# N8N_API_KEY=eyJ...

# Owner credentials for the local n8n container (matches the docker-compose
# defaults you'll set through the UI on first boot).
# N8N_USER_EMAIL=owner@example.com
# N8N_USER_PASSWORD=changeme
